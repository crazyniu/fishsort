; Engine configuration file.
config_version=5

[application]

config/name="泡泡海湾"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Platform="*res://src/services/platform_service.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=750
window/size/viewport_height=1334
window/size/window_width_override=900
window/size/window_height_override=1600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
