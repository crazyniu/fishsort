; Engine configuration file.
config_version=5

[application]

config/name="啵啵救援队"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Platform="*res://src/services/platform_service.gd"
Config="*res://src/services/config_service.gd"
Save="*res://src/services/save_service.gd"
Audio="*res://src/services/audio_service.gd"
Ads="*res://src/services/ad_service.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=750
window/size/viewport_height=1334
window/size/window_width_override=900
window/size/window_height_override=1600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[importer_defaults]

texture={
"mipmaps/generate": true
}

[gui]

theme/custom_font="res://assets/fonts/ResourceHanRoundedCN-Heavy.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.zh_CN.translation", "res://i18n/strings.en.translation")
locale/fallback="zh_CN"

[rendering]

textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=2

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
